# ============ SOURCE SELECTION ============
# confluence | mediawiki
SOURCE=confluence

# ============ CONFLUENCE ============
CONFLUENCE_BASE_URL=https://<your-site>.atlassian.net
CONFLUENCE_EMAIL=<your-email>
CONFLUENCE_API_TOKEN=<atlassian-api-token>
CONFLUENCE_PARENT_PAGE_ID=<root-page-id>

# ============ MEDIAWIKI (used when SOURCE=mediawiki) ============
# WIKI_API_URL=https://en.wikipedia.org/w/api.php
# WIKI_BASE_URL=https://en.wikipedia.org/wiki
# WIKI_NAMESPACE=0
# WIKI_CATEGORY=Category:Machine_learning
# WIKI_PAGE_LIMIT=50

# ============ LLM (optional — omit to run retrieval-only) ============
OPENAI_API_KEY=<openai-key>
OPENAI_MODEL=gpt-4.1-mini
LLM_PROVIDER=openai

# ============ EMBEDDINGS / RETRIEVAL (optional overrides) ============
EMBEDDING_MODEL=all-MiniLM-L6-v2
TOP_K=20
MIN_SCORE=0.20
CONTEXT_K=5

# ============ HYBRID RETRIEVAL ============
HYBRID=true
HYBRID_ALPHA=0.5     # dense weight; (1-alpha) is BM25 weight
