# ===== Secrets (NEVER commit) =====
.env
*.key
*token*
*secret*

# ===== Python =====
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ipynb_checkpoints/

# ===== Logs / runtime artifacts =====
*.log
data/app.log
data/evaluation/ask_history.json
data/evaluation/results.json
data/evaluation/comparison.json

# ===== Regenerated binaries (rebuild with: python main.py --steps embed index) =====
data/raw/*.html
data/vectorstore/embeddings.npy
data/vectorstore/faiss.index
data/benchmark/vectorstore/
data/benchmark/_*.json

# ===== OS / IDE =====
.DS_Store
Thumbs.db
.idea/
.vscode/
# per-collection generated artifacts
data/collections/*/vectorstore/embeddings.npy
data/collections/*/vectorstore/faiss.index
data/collections/*/raw/*.html
data/collections/*/evaluation/results.json
data/collections/*/evaluation/ask_history.json
